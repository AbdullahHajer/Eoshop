# Frontend development proxy. Only VITE_* values are exposed to browser code.
VITE_API_BASE_URL=http://localhost:8000
DISABLE_HMR=false

# Local Compose settings. Copy this file to .env and replace the password.
APP_PORT=8000
VITE_TENANT_BASE_DOMAIN=eoshop.local
VITE_CENTRAL_DOMAINS=localhost,127.0.0.1,eoshop.local
POSTGRES_DB=platform_main
POSTGRES_USER=eoshop
POSTGRES_PASSWORD=replace-with-a-local-password
