APP_NAME="Eoshop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# Central Domain Configuration for Multi-Tenancy
CENTRAL_DOMAINS=localhost,127.0.0.1,eoshop.local

# Database Configuration (Main Platform Core DB)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=platform_main
DB_USERNAME=eoshop
DB_PASSWORD=replace-with-the-same-value-as-root-postgres-password
DB_SSLMODE=prefer

# Tenant Database Template
TENANT_DB_PREFIX=tenant_

# Google Gemini API Key for AI Store Ideas Generation
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=30

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

CACHE_STORE=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
