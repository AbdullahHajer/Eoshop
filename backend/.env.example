APP_NAME="Mobtaker E-Commerce SaaS"
APP_ENV=local
APP_KEY=base64:3uA7/t5J0JkZ9H2t/8n7Q2Q8uX5sA2V1bC3dE4fG5hI=
APP_DEBUG=true
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost:8000

# Central Domain Configuration for Multi-Tenancy
CENTRAL_DOMAINS=localhost,127.0.0.1,mobtaker.local

# Database Configuration (Main Platform Core DB)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=platform_main
DB_USERNAME=postgres
DB_PASSWORD=secret_postgres_password

# Tenant Database Template
TENANT_DB_PREFIX=tenant_

# Google Gemini API Key for AI Store Ideas Generation
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
