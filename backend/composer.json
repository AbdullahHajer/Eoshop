{
    "name": "eoshop/platform-backend",
    "type": "project",
    "description": "Eoshop multi-tenant commerce API powered by Laravel 12 and Stancl Tenancy",
    "keywords": ["laravel", "framework", "tenancy", "multi-tenant", "ecommerce", "gemini-ai"],
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.9",
        "stancl/tenancy": "^3.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit --colors=always --exclude-group=database",
        "test:database": "phpunit --colors=always --group=database",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "process-timeout": 2000,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "prefer-stable": true
}
