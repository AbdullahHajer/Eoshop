{
    "name": "mobtaker/saas-backend",
    "type": "project",
    "description": "Multi-Tenant E-Commerce SaaS Platform Backend powered by Laravel 11 & Stancl Tenancy",
    "keywords": ["laravel", "framework", "tenancy", "multi-tenant", "ecommerce", "gemini-ai"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "*",
        "laravel/tinker": "^2.9",
        "stancl/tenancy": "^3.8"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "process-timeout": 2000,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "block-advisories": false,
            "block": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
