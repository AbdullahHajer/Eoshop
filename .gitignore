# -----------------------------------------------------------------------------
# Secrets and local environment files
# Keep examples, never commit real environment files.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Private keys and local certificates
*.key
*.pem
*.p12
*.pfx

# -----------------------------------------------------------------------------
# JavaScript / TypeScript
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
build/
coverage/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# PHP / Laravel generated and runtime files
# -----------------------------------------------------------------------------
backend/vendor/
backend/storage/logs/*
backend/storage/app/private/*
backend/storage/app/public/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
backend/bootstrap/cache/*.php
!backend/storage/**/.gitignore
!backend/bootstrap/cache/.gitkeep
.phpunit.result.cache

# -----------------------------------------------------------------------------
# Local tooling and operating-system files
# -----------------------------------------------------------------------------
.idea/
.vscode/
.fleet/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*.tmp
*.log

# Local Docker data directories, if created later.
docker-data/
.docker-local/
